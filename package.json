{
  "name": "kra-lambdas",
  "version": "1.0.0",
  "description": "AWS Lambda functions for KRA project",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "lefthook install"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1053.0",
    "pino": "^9.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1054.0",
    "@types/aws-lambda": "^8.10.130",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "esbuild": "^0.28.0",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3",
    "lefthook": "^2.1.8",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.33.0"
}
