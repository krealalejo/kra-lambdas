{
  "name": "kra-lambdas",
  "version": "1.0.0",
  "description": "AWS Lambda functions for KRA project",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "lefthook install"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1081.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1081.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "lefthook": "^2.1.9",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0"
}
